# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Databases & SQLite logs (including WAL & SHM)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Runtime logs
*.log

# PyTorch & Model Checkpoints / Weights
*.pt
*.pth
*.onnx
*.bin
*.h5
*.safetensors

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / local configs
.env
.env.local

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*Zone.Identifier*

# Data directory: keep projection model assets, ignore generated DBs, keys, archives
data/*
!data/.gitkeep
!data/projection.npz
!data/projection.json
data/*_keys.json
*.tar.gz
*.zip

# Attack query artifacts: runtime generated stolen query pairs (often 50MB - 120MB+)
attack/data/*
!attack/data/.gitkeep

# Local experimental detectors
detector/new*.py